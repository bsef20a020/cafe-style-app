NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/noffelo
JWT_SECRET=change-this-development-jwt-secret
JWT_EXPIRES_IN=12h
CUSTOMER_JWT_SECRET=change-this-development-customer-jwt-secret
CUSTOMER_JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@noffelo.local
ADMIN_PASSWORD=Admin@12345
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WHATSAPP_NUMBER=923001234567
RESERVATION_SLOT_CAPACITY=20
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_CURRENCY=PKR
STRIPE_SECRET_KEY=
RATE_LIMIT_RPM=180
MAX_BODY_BYTES=128kb
USE_LOCAL_VECTORS=true
VECTOR_STORE=pinecone-local
PINECONE_API_KEY=pclocal
PINECONE_INDEX_NAME=noffelo-cafe
PINECONE_HOST=http://pinecone-local:5080
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
VECTOR_DIMENSION=384
PINECONE_CREATE_INDEX=true
GROQ_API_KEY=your_groq_key_here
GROQ_CUSTOMER_MODEL=llama-3.1-8b-instant
GROQ_ADMIN_MODEL=llama-3.3-70b-versatile
GROQ_CUSTOMER_TEMPERATURE=0.7
GROQ_ADMIN_TEMPERATURE=0.3
GROQ_CUSTOMER_MAX_TOKENS=500
GROQ_ADMIN_MAX_TOKENS=1000
VITE_API_URL=http://localhost:5000/api
